[Unit]
Description=FamCalendar — pull latest from GitHub on boot
Before=famcalendar-backend.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/FamCalendar
ExecStart=/home/pi/FamCalendar/scripts/update.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
