# Skylight Calendar - Environment Configuration
# Copy this to .env and fill in your values

# Server
PORT=3001
NODE_ENV=production

# Database - point this at your USB stick mount
# e.g. /media/pi/USBDRIVE/skylight/events.db
DB_PATH=/home/pi/skylight/data/events.db

# Google OAuth2 credentials
# Get these from https://console.cloud.google.com
# Create a project -> Enable Google Calendar API -> Create OAuth2 credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# How often to sync Google Calendar (minutes)
SYNC_INTERVAL_MINUTES=15

# Secret for signing session tokens (generate with: openssl rand -hex 32)
SESSION_SECRET=change_this_to_a_random_string
